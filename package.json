{
  "name": "proxydiablo",
  "version": "0.1.0",
  "description": "A localhost-only, human-in-the-loop proxy for PostgreSQL and shell commands.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist-server/server/main.js",
  "bin": {
    "proxydiablo": "src/cli/proxydiablo.mjs",
    "proxydiablo-ui": "bin/proxydiablo-ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amoserlu/proxydiablo.git"
  },
  "homepage": "https://github.com/amoserlu/proxydiablo#readme",
  "bugs": {
    "url": "https://github.com/amoserlu/proxydiablo/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:client": "tsc -p tsconfig.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/server/main.js",
    "app": "npm run build && npm start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.4",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sql-formatter": "^15.8.2",
    "vite": "^8.2.2",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
